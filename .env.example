# 只使用排盤或基礎解讀可以跳過此檔。要啟用 AI 追問，複製成 .env.local。
# 模型設定只供 npm run interpret 的伺服器讀取。
# AI_PROVIDER=deepseek
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash

# 或用 MiMo
# AI_PROVIDER=mimo
# MIMO_API_KEY=
# MIMO_BASE_URL=https://your-provider/v1
# MIMO_MODEL=model-name

# 或用其他相容 Chat Completions 的服務
# AI_PROVIDER=compatible
# AI_API_KEY=
# AI_BASE_URL=https://your-provider/v1
# AI_MODEL=model-name

# 私用追問服務。使用 24–256 個無空白的 ASCII 字元產生獨立隨機通行碼。
# INTERPRET_ACCESS_TOKEN=
# INTERPRET_ALLOWED_ORIGINS=http://localhost:3000
# INTERPRET_HOST=127.0.0.1
# INTERPRET_PORT=8787

# 只有服務網址可寫入前端。站點用 HTTPS 時，服務也必須用 HTTPS。
# NEXT_PUBLIC_INTERPRET_API_URL=http://127.0.0.1:8787/api/interpret
NEXT_PUBLIC_SITE_URL=http://localhost:3000
